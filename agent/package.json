{
  "name": "@solfoundry/auto-submit-agent",
  "version": "0.1.0",
  "description": "Autonomous Claude agent that discovers Tier-1 bounties, implements solutions, and auto-submits PRs",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
