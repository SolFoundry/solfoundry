    "test": "vitest run",
    "run": "tsx src/bin.ts"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "tsx": "^4.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
